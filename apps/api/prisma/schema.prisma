// Prisma Schema Configuration
// AI Sales Assistant — Autonomous Agentic Commerce Platform
// Phase 7.2: Database Models & Real Data Layer

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ============================================================
// ENUMS — Phase 7.2 additions alongside existing
// ============================================================

enum UserRole {
  ADMIN
  MERCHANT
  CUSTOMER
}

enum MerchantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  OUT_OF_STOCK
}

enum BundleDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
  EXPIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  PROCESSING
  COMPLETED
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  WALLET
  CASH_ON_DELIVERY
}

enum RefundStatus {
  PENDING
  APPROVED
  PROCESSED
  REJECTED
}

enum ConversationStatus {
  ACTIVE
  CLOSED
  ARCHIVED
  EXPIRED
}

enum MessageType {
  USER
  AI
  SYSTEM
  ASSISTANT
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AuditEventStatus {
  SUCCESS
  FAILED
  PENDING
  ERROR
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActorType {
  USER
  CUSTOMER
  SYSTEM
  AI_AGENT
}

enum CampaignType {
  EMAIL
  SMS
  WHATSAPP
  PUSH_NOTIFICATION
  ON_SITE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  ORDER
  PAYMENT
  INVENTORY
  AI_ALERT
  SYSTEM
  MARKETING
}

enum NotificationLevel {
  INFO
  SUCCESS
  WARNING
  ERROR
  CRITICAL
}

// ============================================================
// SYSTEM HEALTH MONITORING
// ============================================================

model SystemHealthCheck {
  id        String   @id @default(cuid())
  service   String
  status    String
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("system_health_checks")
}

// ============================================================
// USER & AUTHENTICATION
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?   @map("password_hash")
  role          UserRole  @default(MERCHANT)
  isActive      Boolean   @default(true) @map("is_active")
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  stores        Store[]
  notifications Notification[]

  @@map("users")
}

// ============================================================
// STORE / MERCHANT
// ============================================================

model Store {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  logoUrl     String?        @map("logo_url")
  websiteUrl  String?        @map("website_url")
  currency    String         @default("INR")
  timezone    String         @default("Asia/Kolkata")
  email       String?
  phone       String?
  status      MerchantStatus @default(ACTIVE)
  isActive    Boolean        @default(true) @map("is_active")
  ownerId     String         @map("owner_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products        Product[]
  bundles         Bundle[]
  orders          Order[]
  customers       Customer[]
  campaigns       Campaign[]
  aiSettings      AiSettings?
  sessions        Session[]
  categories      ProductCategory[]
  carts           ShoppingCart[]
  payments        Payment[]
  aiDecisions     AiDecision[]
  auditEvents     AuditEvent[]
  analyticsEvents AnalyticsEvent[]
  agentActions    AgentAction[]
  merchantPolicy  MerchantPolicy?

  @@index([ownerId])
  @@index([slug])
  @@index([status])
  @@index([createdAt])
  @@map("stores")
}

// ============================================================
// PRODUCT CATEGORY (with nested / parent-child support)
// ============================================================

model ProductCategory {
  id          String   @id @default(cuid())
  storeId     String   @map("store_id")
  name        String
  slug        String
  description String?
  parentId    String?  @map("parent_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store    Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   ProductCategory?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryToCategory")
  products Product[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([parentId])
  @@index([createdAt])
  @@map("product_categories")
}

// ============================================================
// PRODUCT
// ============================================================

model Product {
  id           String   @id @default(cuid())
  storeId      String   @map("store_id")
  categoryId   String?  @map("category_id")
  name         String
  slug         String?
  description  String?
  brand        String?
  sku          String
  price        Decimal  @db.Decimal(10, 2)
  comparePrice Decimal? @map("compare_price") @db.Decimal(10, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(10, 2)
  costPrice    Decimal? @map("cost_price") @db.Decimal(10, 2)
  currency     String   @default("INR")
  images       String[]
  category     String?
  tags         String[]
  stock        Int      @default(0)
  lowStock     Int      @default(10) @map("low_stock")
  status       ProductStatus @default(ACTIVE)
  isActive     Boolean  @default(true) @map("is_active")
  isFeatured   Boolean  @default(false) @map("is_featured")
  isBestSeller Boolean  @default(false) @map("is_best_seller")
  weight       Float?
  dimensions   String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  embedding Unsupported("vector(1536)")?

  store           Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productCategory ProductCategory?   @relation(fields: [categoryId], references: [id])
  variants        ProductVariant[]
  inventory       Inventory[]
  orderItems      OrderItem[]
  bundleItems     BundleItem[]
  cartItems       CartItem[]
  recommendations AiRecommendation[]

  @@unique([storeId, sku])
  @@unique([storeId, slug])
  @@index([storeId])
  @@index([sku])
  @@index([categoryId])
  @@index([isActive])
  @@index([status])
  @@index([createdAt])
  @@map("products")
}

// ============================================================
// PRODUCT VARIANT
// ============================================================

model ProductVariant {
  id         String        @id @default(cuid())
  productId  String        @map("product_id")
  sku        String        @unique
  name       String
  price      Decimal       @db.Decimal(10, 2)
  attributes Json?
  status     ProductStatus @default(ACTIVE)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([sku])
  @@index([createdAt])
  @@map("product_variants")
}

// ============================================================
// INVENTORY
// ============================================================

model Inventory {
  id                String          @id @default(cuid())
  productId         String?         @map("product_id")
  variantId         String?         @map("variant_id")
  quantity          Int             @default(0)
  reservedQuantity  Int             @default(0) @map("reserved_quantity")
  lowStockThreshold Int             @default(10) @map("low_stock_threshold")
  status            InventoryStatus @default(AVAILABLE)
  updatedAt         DateTime        @updatedAt @map("updated_at")

  product Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@index([status])
  @@map("inventory")
}

// ============================================================
// BUNDLES
// ============================================================

model Bundle {
  id            String             @id @default(cuid())
  name          String
  description   String?
  discountType  BundleDiscountType @map("discount_type")
  discountValue Decimal            @map("discount_value") @db.Decimal(5, 2)
  isActive      Boolean            @default(true) @map("is_active")
  storeId       String             @map("store_id")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  store Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items BundleItem[]

  @@index([storeId])
  @@map("bundles")
}

model BundleItem {
  id        String @id @default(cuid())
  bundleId  String @map("bundle_id")
  productId String @map("product_id")
  quantity  Int    @default(1)

  bundle  Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bundleId, productId])
  @@index([bundleId])
  @@index([productId])
  @@map("bundle_items")
}

// ============================================================
// CUSTOMER
// ============================================================

model Customer {
  id          String    @id @default(cuid())
  storeId     String    @map("store_id")
  name        String?
  externalId  String?   @map("external_id")
  email       String?
  phone       String?
  firstName   String?   @map("first_name")
  lastName    String?   @map("last_name")
  dateOfBirth DateTime? @map("date_of_birth")
  avatarUrl   String?   @map("avatar_url")
  notes       String?
  tags        String[]
  totalSpent  Decimal   @default(0) @map("total_spent") @db.Decimal(12, 2)
  orderCount  Int       @default(0) @map("order_count")
  lastOrderAt DateTime? @map("last_order_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders            Order[]
  sessions          Session[]
  carts             ShoppingCart[]
  aiConversations   AiConversation[]
  aiRecommendations AiRecommendation[]
  aiDecisions       AiDecision[]
  auditEvents       AuditEvent[]
  analyticsEvents   AnalyticsEvent[]

  @@index([storeId])
  @@index([email])
  @@index([externalId])
  @@index([createdAt])
  @@map("customers")
}

// ============================================================
// SHOPPING CART & CART ITEMS
// ============================================================

model ShoppingCart {
  id         String     @id @default(cuid())
  storeId    String     @map("store_id")
  customerId String?    @map("customer_id")
  status     CartStatus @default(ACTIVE)
  currency   String     @default("INR")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    CartItem[]

  @@index([storeId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("shopping_carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String   @map("cart_id")
  productId String   @map("product_id")
  variantId String?  @map("variant_id")
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    ShoppingCart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@map("cart_items")
}

// ============================================================
// ORDER & ORDER ITEMS
// ============================================================

model Order {
  id                String        @id @default(cuid())
  storeId           String        @map("store_id")
  customerId        String?       @map("customer_id")
  orderNumber       String        @unique @map("order_number")
  customerEmail     String?       @map("customer_email")
  customerName      String?       @map("customer_name")
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod     PaymentMethod @map("payment_method")
  subtotal          Decimal       @map("subtotal") @db.Decimal(12, 2)
  discount          Decimal       @default(0) @map("discount") @db.Decimal(10, 2)
  tax               Decimal       @default(0) @map("tax") @db.Decimal(10, 2)
  shipping          Decimal       @default(0) @map("shipping") @db.Decimal(10, 2)
  total             Decimal       @map("total") @db.Decimal(12, 2)
  currency          String        @default("INR")
  notes             String?
  couponCode        String?       @map("coupon_code")
  aiAssisted        Boolean       @default(false) @map("ai_assisted")
  aiSessionId       String?       @map("ai_session_id")
  razorpayOrderId   String?       @map("razorpay_order_id")
  razorpayPaymentId String?       @map("razorpay_payment_id")
  shippingAddress   Json?         @map("shipping_address")
  billingAddress    Json?         @map("billing_address")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  store    Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?   @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  refunds  Refund[]
  session  Session?    @relation(fields: [aiSessionId], references: [id])
  payment  Payment?

  @@index([storeId])
  @@index([customerId])
  @@index([status])
  @@index([orderNumber])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  productId   String   @map("product_id")
  variantId   String?  @map("variant_id")
  productName String   @map("product_name")
  sku         String?
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  discount    Decimal? @default(0) @db.Decimal(10, 2)
  totalPrice  Decimal  @map("total_price") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([sku])
  @@index([createdAt])
  @@map("order_items")
}

// ============================================================
// PAYMENT
// ============================================================

model Payment {
  id                String        @id @default(cuid())
  storeId           String        @map("store_id")
  orderId           String        @unique @map("order_id")
  provider          String
  providerOrderId   String?       @map("provider_order_id")
  providerPaymentId String?       @map("provider_payment_id")
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  method            PaymentMethod
  failureCode       String?       @map("failure_code")
  failureMessage    String?       @map("failure_message")
  verifiedAt        DateTime?     @map("verified_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([orderId])
  @@unique([storeId, providerPaymentId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

// ============================================================
// REFUND
// ============================================================

model Refund {
  id               String       @id @default(cuid())
  orderId          String       @map("order_id")
  amount           Decimal      @db.Decimal(10, 2)
  reason           String?
  status           RefundStatus @default(PENDING)
  razorpayRefundId String?      @map("razorpay_refund_id")
  processedAt      DateTime?    @map("processed_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("refunds")
}

// ============================================================
// SESSION & SESSION EVENTS
// ============================================================

model Session {
  id          String   @id @default(cuid())
  sessionId   String   @unique @map("session_id")
  customerId  String?  @map("customer_id")
  storeId     String   @map("store_id")
  device      String?
  browser     String?
  location    String?
  referrer    String?
  landingPage String?  @map("landing_page")
  currentPage String?  @map("current_page")
  duration    Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  aiEnabled   Boolean  @default(true) @map("ai_enabled")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer      Customer?        @relation(fields: [customerId], references: [id])
  store         Store            @relation(fields: [storeId], references: [id])
  orders        Order[]
  events        SessionEvent[]
  conversations AiConversation[]

  @@index([storeId])
  @@index([customerId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("sessions")
}

model SessionEvent {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  eventType String   @map("event_type")
  eventData Json?    @map("event_data")
  pageUrl   String?  @map("page_url")
  createdAt DateTime @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([eventType])
  @@map("session_events")
}

// ============================================================
// AI CONVERSATION TRACKING
// ============================================================

model AiConversation {
  id         String             @id @default(cuid())
  storeId    String             @map("store_id")
  customerId String?            @map("customer_id")
  sessionId  String             @map("session_id")
  status     ConversationStatus @default(ACTIVE)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  message     String?
  messageType MessageType?     @map("message_type")
  productIds  String[]         @map("product_ids")
  confidence  Float?
  metadata    Json?

  session         Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  customer        Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages        AiMessage[]
  recommendations AiRecommendation[]
  decisions       AiDecision[]

  @@index([sessionId])
  @@index([storeId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String      @id @default(cuid())
  conversationId String      @map("conversation_id")
  role           MessageType
  content        String
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("ai_messages")
}

model AiRecommendation {
  id              String   @id @default(cuid())
  conversationId  String   @map("conversation_id")
  customerId      String?  @map("customer_id")
  productId       String   @map("product_id")
  reason          String?
  confidenceScore Float    @map("confidence_score")
  rank            Int
  accepted        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer     Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([customerId])
  @@index([productId])
  @@index([accepted])
  @@index([createdAt])
  @@map("ai_recommendations")
}

model AiDecision {
  id                     String   @id @default(cuid())
  storeId                String   @map("store_id")
  customerId             String?  @map("customer_id")
  conversationId         String?  @map("conversation_id")
  decisionType           String   @map("decision_type")
  inputSummary           String   @map("input_summary")
  decision               String
  confidenceScore        Float    @map("confidence_score")
  reason                 String
  rulesApplied           Json?    @map("rules_applied")
  alternativesConsidered Json?    @map("alternatives_considered")
  createdAt              DateTime @default(now()) @map("created_at")

  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer     Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([customerId])
  @@index([conversationId])
  @@index([decisionType])
  @@index([createdAt])
  @@map("ai_decisions")
}

// ============================================================
// AUDIT EVENTS (append-only)
// ============================================================

model AuditEvent {
  id         String           @id @default(cuid())
  storeId    String           @map("store_id")
  customerId String?          @map("customer_id")
  orderId    String?          @map("order_id")
  paymentId  String?          @map("payment_id")
  eventType  String           @map("event_type")
  status     AuditEventStatus @default(SUCCESS)
  riskLevel  RiskLevel        @default(LOW) @map("risk_level")
  requestId  String?          @map("request_id")
  actorType  ActorType        @map("actor_type")
  actorId    String?          @map("actor_id")
  metadata   Json?
  createdAt  DateTime         @default(now()) @map("created_at")

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([customerId])
  @@index([orderId])
  @@index([paymentId])
  @@index([eventType])
  @@index([riskLevel])
  @@index([createdAt])
  @@map("audit_events")
}

// ============================================================
// ANALYTICS EVENTS
// ============================================================

model AnalyticsEvent {
  id         String   @id @default(cuid())
  storeId    String   @map("store_id")
  customerId String?  @map("customer_id")
  sessionId  String?  @map("session_id")
  eventType  String   @map("event_type")
  productId  String?  @map("product_id")
  orderId    String?  @map("order_id")
  value      Decimal? @db.Decimal(12, 2)
  currency   String?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([customerId])
  @@index([sessionId])
  @@index([eventType])
  @@index([productId])
  @@index([orderId])
  @@index([createdAt])
  @@map("analytics_events")
}

// ============================================================
// CAMPAIGNS
// ============================================================

model Campaign {
  id          String         @id @default(cuid())
  name        String
  description String?
  type        CampaignType
  status      CampaignStatus @default(DRAFT)
  audience    Json?
  channel     String
  schedule    DateTime?
  metrics     Json?
  storeId     String         @map("store_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([status])
  @@index([createdAt])
  @@map("campaigns")
}

// ============================================================
// AI SETTINGS PER STORE
// ============================================================

model AiSettings {
  id                  String   @id @default(cuid())
  storeId             String   @unique @map("store_id")
  isEnabled           Boolean  @default(true) @map("is_enabled")
  confidenceThreshold Float    @default(0.7) @map("confidence_threshold")
  maxRecommendations  Int      @default(5) @map("max_recommendations")
  enableCartRecovery  Boolean  @default(true) @map("enable_cart_recovery")
  enableUpsell        Boolean  @default(true) @map("enable_upsell")
  enableBundling      Boolean  @default(true) @map("enable_bundling")
  customPrompt        String?  @map("custom_prompt")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String            @id @default(cuid())
  userId    String            @map("user_id")
  title     String
  message   String
  type      NotificationType
  level     NotificationLevel @default(INFO)
  isRead    Boolean           @default(false) @map("is_read")
  actionUrl String?           @map("action_url")
  metadata  Json?
  createdAt DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// AGENT ACTIONS — Phase 7.10 Guardrails
// ============================================================

model AgentAction {
  id               String    @id @default(cuid())
  storeId          String    @map("store_id")
  actionType       String    @map("action_type")
  targetProductId  String?   @map("target_product_id")
  targetEntityId   String?   @map("target_entity_id")
  status           String    @default("PROPOSED")
  riskLevel        RiskLevel @default(MEDIUM) @map("risk_level")
  requiresApproval Boolean   @default(true) @map("requires_approval")
  reason           String
  evidence         Json?
  parameters       Json?
  confidence       Float?
  proposedBy       String    @default("AI_AGENT") @map("proposed_by")
  approvedBy       String?   @map("approved_by")
  approvedAt       DateTime? @map("approved_at")
  executedBy       String?   @map("executed_by")
  executedAt       DateTime? @map("executed_at")
  executionResult  Json?     @map("execution_result")
  expectedState    Json?     @map("expected_state")
  expiresAt        DateTime? @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([actionType])
  @@index([status])
  @@index([riskLevel])
  @@index([createdAt])
  @@map("agent_actions")
}

// ============================================================
// MERCHANT POLICY — Phase 7.10 Guardrails
// ============================================================

model MerchantPolicy {
  id                            String   @id @default(cuid())
  storeId                       String   @unique @map("store_id")
  maxPriceChangePercent         Float    @default(10.0) @map("max_price_change_percent")
  maxInventoryAdjustment        Int      @default(50) @map("max_inventory_adjustment")
  maxDailyActions               Int      @default(10) @map("max_daily_actions")
  maxHourlyActions              Int      @default(5) @map("max_hourly_actions")
  approvalRequiredForPrice      Boolean  @default(true) @map("approval_required_for_price")
  approvalRequiredForInventory  Boolean  @default(true) @map("approval_required_for_inventory")
  autonomousActionsEnabled      Boolean  @default(false) @map("autonomous_actions_enabled")
  createdAt                     DateTime @default(now()) @map("created_at")
  updatedAt                     DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("merchant_policies")
}

