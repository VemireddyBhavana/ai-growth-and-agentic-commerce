# ==============================================================================
# AI Sales Assistant — Environment Variables Template
# Copy this file to .env or create app-specific .env in apps/api and apps/web
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=5000

# Client Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Database Configuration (PostgreSQL 16 + pgvector)
DATABASE_URL="postgresql://postgres:postgres_secure_password_2026@localhost:5432/ai_sales_assistant?schema=public"

# Redis Cache & Telemetry Queue
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="dev_jwt_secret_super_secure_key_min_32_chars_2026_xai_commerce"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="dev_jwt_refresh_super_secure_key_min_32_chars_2026_xai"
JWT_REFRESH_EXPIRES_IN="30d"

# OpenAI SDK Configuration
OPENAI_API_KEY="sk-mock-development-key-replace-with-valid-key"
OPENAI_MODEL="gpt-4o"

# Razorpay SDK Configuration (Test Mode)
RAZORPAY_KEY_ID="rzp_test_mock_key_id"
RAZORPAY_KEY_SECRET="mock_key_secret_for_test_mode"
RAZORPAY_WEBHOOK_SECRET="mock_webhook_secret_key"

# Logging & Observability
LOG_LEVEL="debug"
CORS_ORIGIN="http://localhost:3000"
