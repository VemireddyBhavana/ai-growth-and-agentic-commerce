# ==============================================================================
# AI Sales Assistant — Environment Variables Template
# Copy this file to .env or create app-specific .env in apps/api and apps/web
# ==============================================================================

# ------------------------------------------------------------------------------
# PUBLIC CONFIGURATION (Safe for browser / frontend)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_mock_key_id
NEXT_PUBLIC_STORE_ID=acme-retail
NEXT_PUBLIC_DATA_SOURCE_MODE=mock
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# ------------------------------------------------------------------------------
# SERVER-ONLY CONFIGURATION (NEVER expose these to the browser)
# ------------------------------------------------------------------------------

# Node Environment
NODE_ENV=development
PORT=5000

# Database Configuration (PostgreSQL 16 + pgvector)
DATABASE_URL="postgresql://postgres:postgres_secure_password_2026@localhost:5432/ai_sales_assistant?schema=public"

# Redis Cache & Telemetry Queue
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="dev_jwt_secret_super_secure_key_min_32_chars_2026_xai_commerce"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="dev_jwt_refresh_super_secure_key_min_32_chars_2026_xai"
JWT_REFRESH_EXPIRES_IN="30d"

# OpenAI SDK Configuration
OPENAI_API_KEY="sk-mock-development-key-replace-with-valid-key"
OPENAI_MODEL="gpt-4o"

# Razorpay SDK Configuration
RAZORPAY_MODE="test"
RAZORPAY_KEY_ID="rzp_test_mock_key_id"
RAZORPAY_KEY_SECRET="mock_key_secret_for_test_mode"
RAZORPAY_WEBHOOK_SECRET="mock_webhook_secret_key"

# Supabase Admin
SUPABASE_URL="https://placeholder.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="placeholder-service-role-key"

# Logging & Observability
LOG_LEVEL="debug"
CORS_ORIGIN="http://localhost:3000"

